APP_ENV=development
APP_NAME=CasinoKing Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

BACKEND_PORT=8000
EDGE_PORT=3000
FRONTEND_V3_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_V3_BASE_URL=http://localhost:3000
SITE_V3_API_INTERNAL_BASE_URL=http://backend:8000/api/v1
SITE_V3_ASSET_PREFIX=/site-v3-assets
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3100,http://127.0.0.1:3100,http://localhost:3101,http://127.0.0.1:3101,http://localhost:3102,http://127.0.0.1:3102,http://localhost:3103,http://127.0.0.1:3103,http://localhost:3104,http://127.0.0.1:3104,http://localhost:3200,http://127.0.0.1:3200

POSTGRES_DB=casinoking
POSTGRES_USER=casinoking
POSTGRES_PASSWORD=
POSTGRES_PORT=56543

REDIS_PORT=56800
DATABASE_URL=postgresql://casinoking:casinoking@postgres:5432/casinoking
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=60
# Chiave HMAC del fornitore M&M Games (PASSO 3-bis): in produzione va
# impostata nel file d'ambiente; nello stack locale vale il default di
# docker-compose. Se assente e senza default, il fornitore non si registra
# e ogni sua chiamata riceve 401 (chiuso per difetto, vedi providers/registry.py).
MANDM_SECRET_KEY=
SITE_V3_DRAFT_PREVIEW_SECRET=
SITE_V3_PUBLIC_BASE_URL=http://localhost:3000
SITE_ACCESS_PASSWORD=
MINES_SERVER_SEED=


# Amministratore tecnico locale (PZ-03)
LOCAL_ADMIN_EMAIL=codex.agent@example.com
LOCAL_ADMIN_PASSWORD=
